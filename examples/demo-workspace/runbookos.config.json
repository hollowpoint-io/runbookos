{
  "name": "RunbookOS Demo Workspace",
  "defaultProvider": "codex",
  "modelTiers": {
    "deep": {
      "claude": "opus",
      "codex": "gpt-5.5"
    },
    "balanced": {
      "claude": "sonnet",
      "codex": "gpt-5.4"
    },
    "fast": {
      "claude": "haiku",
      "codex": "gpt-5.4-mini"
    }
