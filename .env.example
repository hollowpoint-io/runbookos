# RunbookOS never ships real credentials.
# Copy this to .env inside your private workspace.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SHOPIFY_ADMIN_TOKEN=
SHOPIFY_SHOP_DOMAIN=
RUNBOOKOS_SHOPIFY_AUTH_MODE=fixture
RUNBOOKOS_SHOPIFY_FIXTURE=

AHREFS_API_TOKEN=
RUNBOOKOS_AHREFS_AUTH_MODE=fixture
RUNBOOKOS_AHREFS_FIXTURE=
RUNBOOKOS_AHREFS_MAX_ROWS=25
RUNBOOKOS_AHREFS_DATE=
AHREFS_LIVE_TEST_DOMAIN=
AHREFS_LIVE_TEST_COUNTRY=gb
RUNBOOKOS_LOCAL_SEO_FIXTURE=
# Bright Data's official MCP currently expects API_TOKEN. Keep provider-specific
# aliases private if a wrapper package maps them differently later.
API_TOKEN=
BRIGHTDATA_API_TOKEN=
GMAIL_ACCOUNT=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

CONTEXT7_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TOKEN=
LINEAR_API_KEY=
NOTION_TOKEN=
FIRECRAWL_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=
IMAGE_PROVIDER_API_KEY=
