{
  "name": "Demo Agency Workspace",
  "defaultProvider": "codex",
  "modelTiers": {
    "deep": {
      "claude": "opus",
      "codex": "gpt-5.5"
    },
    "balanced": {
      "claude": "sonnet",
      "codex": "gpt-5.4"
    },
    "fast": {
      "claude": "haiku",
      "codex": "gpt-5.4-mini"
    }
  },
  "memory": {
    "activeContextFile": "ACTIVE_CONTEXT.md",
    "longTermFile": "MEMORY.md",
    "dailyLogDir": "memory"
  },
  "workspace": {
    "clientRoot": "workspace/clients",
    "allowedWriteRoots": [
      "workspace",
      "memory",
      "outbox"
    ]
  },
  "skills": [
    "seo-research",
    "competitor-analysis",
    "shopify-audit",
    "shopify-theme-audit",
    "shopify-product-listing",
    "shopify-collection-content",
    "shopify-merchandising",
    "shopify-bulk-operations",
    "content-writing",
    "proposal-builder",
    "lead-generation",
    "local-seo",
    "image-generation",
    "session-wrapup"
  ],
  "mcpServers": {
    "workspace": {
      "enabled": true,
      "env": []
    },
    "shopify": {
      "enabled": false,
      "env": [
        "RUNBOOKOS_SHOPIFY_AUTH_MODE",
        "SHOPIFY_ADMIN_TOKEN",
        "SHOPIFY_SHOP_DOMAIN",
        "SHOPIFY_API_VERSION"
      ]
    },
    "ahrefs": {
      "enabled": false,
      "env": [
        "RUNBOOKOS_AHREFS_AUTH_MODE",
        "AHREFS_API_TOKEN",
        "RUNBOOKOS_AHREFS_FIXTURE",
        "RUNBOOKOS_AHREFS_MAX_ROWS",
        "RUNBOOKOS_AHREFS_DATE"
      ]
    },
    "brightdata": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@brightdata/mcp"
      ],
      "env": [
        "API_TOKEN"
      ]
    },
    "gmail": {
      "enabled": false,
      "env": [
        "GMAIL_CLIENT_ID",
        "GMAIL_CLIENT_SECRET",
        "GMAIL_REFRESH_TOKEN",
        "GMAIL_USER_EMAIL"
      ]
    },
    "image": {
      "enabled": false,
      "env": [
        "IMAGE_PROVIDER_API_KEY"
      ]
    },
    "context7": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "env": [
        "CONTEXT7_API_KEY"
      ]
    },
    "gsc": {
      "enabled": false,
      "env": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REFRESH_TOKEN"
      ]
    },
    "ga4": {
      "enabled": false,
      "env": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REFRESH_TOKEN"
      ]
    },
    "github": {
      "enabled": false,
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_READ_ONLY=1",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": [
        "GITHUB_PERSONAL_ACCESS_TOKEN"
      ]
    },
    "linear": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "env": []
    },
    "notion": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.notion.com/mcp"
      ],
      "env": []
    },
    "gdrive": {
      "enabled": false,
      "env": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REFRESH_TOKEN"
      ]
    },
    "firecrawl": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": [
        "FIRECRAWL_API_KEY"
      ]
    },
    "exa": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": [
        "EXA_API_KEY"
      ]
    },
    "perplexity": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "env": [
        "PERPLEXITY_API_KEY"
      ]
    },
    "browser": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": []
    },
    "memory": {
      "enabled": true,
      "env": []
    }
  }
}
